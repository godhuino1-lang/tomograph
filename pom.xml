<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.tomograph</groupId>
  <artifactId>tomograph-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Tomograph</name>
  <description>Zero-instrumentation observability and deterministic replay for LLM agents running on the JVM</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>tomograph-api</module>
    <module>tomograph-core</module>
    <module>tomograph-javaagent</module>
    <module>tomograph-examples</module>
  </modules>

  <properties>
    <!--
      Baseline is Java 17, NOT 8 or 11: the target frameworks (LangChain4j, Spring AI)
      themselves require 17+, so there is no host application to observe below 17.
      See docs/adr/0001-java-baseline.md.
      Local dev runs on a newer JDK (26) and cross-compiles down to 17 with the
      compiler's release flag.
    -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <plugin.compiler.version>3.13.0</plugin.compiler.version>
    <plugin.shade.version>3.6.0</plugin.shade.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.tomograph</groupId>
        <artifactId>tomograph-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.tomograph</groupId>
        <artifactId>tomograph-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${plugin.compiler.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${plugin.shade.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
