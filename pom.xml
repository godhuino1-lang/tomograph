<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.godhuino1-lang</groupId>
  <artifactId>tomograph-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Tomograph</name>
  <description>Zero-instrumentation observability and deterministic replay for LLM agents running on the JVM</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>tomograph-api</module>
    <module>tomograph-semconv</module>
    <module>tomograph-exporter-otlp</module>
    <module>tomograph-core</module>
    <module>tomograph-javaagent</module>
    <module>tomograph-instrumentation-langchain4j</module>
    <module>tomograph-report-html</module>
    <module>tomograph-examples</module>
  </modules>

  <properties>
    <!--
      Baseline is Java 17, NOT 8 or 11: the target frameworks (LangChain4j, Spring AI)
      themselves require 17+, so there is no host application to observe below 17.
      See docs/adr/0001-java-baseline.md.
      Local dev runs on a newer JDK (26) and cross-compiles down to 17 with the
      compiler's release flag.
    -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Plugin and dependency versions are pinned to what the project has been verified
      against, not to "latest". On the author's machine the Maven local repository is
      frozen and unreachable (see ARCHITECTURE.md), so a version bump that is not
      already cached fails the build outright. Bump deliberately, and verify.
    -->
    <junit.version>5.12.2</junit.version>
    <!--
      Jackson is used by tomograph-report-html only. The agent stays dependency-free
      (ADR 0003) because it is injected into somebody else's JVM; an offline report
      generator that runs over a file has no such constraint. See ADR 0005.
    -->
    <jackson.version>2.19.4</jackson.version>
    <plugin.compiler.version>3.13.0</plugin.compiler.version>
    <plugin.surefire.version>3.5.6</plugin.surefire.version>
    <plugin.shade.version>3.6.0</plugin.shade.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.godhuino1-lang</groupId>
        <artifactId>tomograph-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.godhuino1-lang</groupId>
        <artifactId>tomograph-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.godhuino1-lang</groupId>
        <artifactId>tomograph-semconv</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        junit-jupiter-api + junit-jupiter-engine rather than the junit-jupiter
        aggregator: the aggregator also pulls junit-jupiter-params, which the project
        does not use, and one fewer moving part is one fewer thing to break.
      -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-api</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-engine</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${plugin.compiler.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${plugin.surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${plugin.shade.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!--
    The LangChain4j integration test lives behind a profile rather than in the default build.

    Reason: that module needs the framework's jar, and this development environment cannot fetch
    Maven artefacts at all (see ARCHITECTURE.md). A default build that fails because a download did
    not happen trains everyone to ignore a red build. Once the jar is in the local repository:

      mvn -o -Pwith-langchain4j verify

    Run the whole reactor, not -pl on the integration module alone: with -pl, Maven also cannot see
    the sibling Tomograph modules that have not been installed, and the failure then looks like a
    broken build rather than a missing download.

    Without the jar the failure is specific and is the useful kind:
      Cannot access alimaven in offline mode and the artifact
      dev.langchain4j:langchain4j-core:jar:1.21.0 has not been downloaded from it before.
    That message names exactly what to fetch. `mvn validate` on this module proves nothing, by the
    way - validate does not resolve dependencies, so the profile looks wired up whether it is or not.

    What it proves, and why nothing else can: the module reads its attributes reflectively, so the
    accessor names are strings (ADR 0008). Only a real jar can say whether the first candidate name
    is still the right one.
  -->
  <profiles>
    <profile>
      <id>with-langchain4j</id>
      <modules>
        <module>tomograph-integration-tests</module>
      </modules>
    </profile>
  </profiles>
</project>
