<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.godhuino1-lang</groupId>
    <artifactId>tomograph-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tomograph-javaagent</artifactId>
  <name>Tomograph :: Java Agent</name>
  <description>Shaded, self-contained -javaagent jar. This is the artifact users download.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.godhuino1-lang</groupId>
      <artifactId>tomograph-core</artifactId>
    </dependency>
    <!--
      The exporter is a shaded dependency of the agent, never of tomograph-core: the
      engine discovers sinks through ServiceLoader and stays ignorant of OTLP. See
      tomograph-api's SpanSinkProvider. The version is spelled out rather than managed in
      the parent so that adding a module does not require editing two files.
    -->
    <dependency>
      <groupId>io.github.godhuino1-lang</groupId>
      <artifactId>tomograph-exporter-otlp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Shaded in as well, and for a related reason: an instrumentation module supplied by the host
      application builds W3C-shaped ids with TraceContext, so that class has to be on a classpath
      the module can see. Without it the module fails at class-loading time with
      NoClassDefFoundError, which the end-to-end test would report as "the agent exported nothing".
    -->
    <dependency>
      <groupId>io.github.godhuino1-lang</groupId>
      <artifactId>tomograph-semconv</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <!-- Users reference this exact filename in their JVM flags, so it is part of the API. -->
    <finalName>tomograph-agent</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- The agent jar is never a dependency of anything, so a reduced pom is pure noise. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <transformers>
                <!--
                  Premain-Class / Agent-Class are what make the jar an agent at all.
                  Getting these strings wrong produces the classic, useless failure:
                  "Failed to find Premain-Class manifest attribute".
                -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>io.github.godhuino1.tomograph.javaagent.TomographAgent</Premain-Class>
                    <Agent-Class>io.github.godhuino1.tomograph.javaagent.TomographAgent</Agent-Class>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                    <!--
                      Read at runtime by io.github.godhuino1.tomograph.core.TomographVersion and attached to
                      every span. Without these the agent reports itself as "dev", which makes
                      "which build produced this trace?" unanswerable in production.
                    -->
                    <Implementation-Title>Tomograph</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <!--
                  Merges META-INF/services/* from every dependency, which is what lets
                  instrumentation modules be discovered by ServiceLoader inside the fat jar.
                  Without this, adding a module would silently do nothing.
                -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
