<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.godhuino1-lang</groupId>
    <artifactId>tomograph-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tomograph-example-fakeagent</artifactId>
  <name>Tomograph :: Examples :: Fake Agent</name>
  <description>A deliberately naive stand-in for a real LLM agent, used as the integration test harness.</description>

  <dependencies>
    <!--
      Needed so this module can implement the SPI. At runtime the classes come from
      the agent jar instead, which is exactly the point: the example has no compile
      dependency on the agent.
    -->
    <dependency>
      <groupId>io.github.godhuino1-lang</groupId>
      <artifactId>tomograph-api</artifactId>
    </dependency>
    <!--
      For TraceContext: a W3C span id is 16 hex characters, and building ids by hand is how this
      module once shipped 32-character span ids that no backend would accept. At runtime these
      classes come from the agent jar, which shades the module in - so there is still no compile
      dependency on the agent itself.
    -->
    <dependency>
      <groupId>io.github.godhuino1-lang</groupId>
      <artifactId>tomograph-semconv</artifactId>
    </dependency>
    <!--
      Test scope only. DynamicAttachTest spawns a real JVM and attaches the built agent jar
      to it, which is the only way to prove the agentmain path: the development sandbox
      blocks named pipes, so the attach mechanism cannot be exercised there at all.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
  </dependencies>
</project>
